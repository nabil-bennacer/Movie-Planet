<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.LoginController">

    <children>
        <Button layoutX="284.0" layoutY="251.0" mnemonicParsing="false" onAction="#onLoginButtonClick" text="Login" />

        <TextField fx:id="usernameField" layoutX="232.0" layoutY="137.0" promptText="username" />

        <PasswordField fx:id="passwordField" layoutX="232.0" layoutY="174.0" promptText="Password" />

        <Label fx:id="messageLabel" layoutX="232.0" layoutY="210.0" textFill="red" />
      <ImageView fitHeight="102.0" fitWidth="126.0" layoutX="256.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/logo.png" />
         </image>
      </ImageView>
    </children>
</AnchorPane>
