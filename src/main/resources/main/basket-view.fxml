<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.BasketController">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Bouton de retour -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="← Retour au Dashboard" onAction="#onBackToDashboard" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </HBox>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Mon Panier - MoviePlanet" />

    <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="productColumn" prefWidth="250.0" text="Article" />
            <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Prix Unitaire (€)" />
            <TableColumn fx:id="quantityColumn" prefWidth="80.0" text="Quantité" />
            <TableColumn fx:id="totalItemColumn" prefWidth="120.0" text="Total Ligne (€)" />
        </columns>
        
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        
        <Button onAction="#onRemoveItem" style="-fx-background-color: #ff5252; -fx-text-fill: white;" text="Supprimer l'article" />
        <Button onAction="#onIncreaseQuantity" text="+ Ajouter Quantité" />

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total: 0.00 €" />
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#onProceedToPayment" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;" text="Payer" />
    </HBox>

</VBox>