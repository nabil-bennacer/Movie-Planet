<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.PaymentController">
    
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Paiement Sécurisé" />

    <VBox maxWidth="400.0" spacing="15.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 20;">
        
        <Label text="Mode de paiement" />
        <ComboBox fx:id="paymentMethodBox" prefWidth="400.0" />

        <Label text="Numéro de Carte / Email PayPal" />
        <TextField fx:id="cardNumberField" promptText="XXXX-XXXX-XXXX-XXXX" />

        <HBox spacing="15.0">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Date d'expiration" />
                <TextField fx:id="expiryField" promptText="MM/AA" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS">
                <Label text="CVV" />
                <TextField fx:id="cvvField" promptText="123" />
            </VBox>
        </HBox>

    </VBox>

    <Label fx:id="errorLabel" text="" />

    <HBox alignment="CENTER" spacing="20.0">
        <Button onAction="#onCancelPayment" style="-fx-background-color: #e0e0e0;" text="Annuler" />
        <Button onAction="#onConfirmPayment" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30;" text="Confirmer le Paiement" />
    </HBox>

</VBox>