<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" 
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ProviderController">
    <VBox spacing="10" layoutX="20" layoutY="20">
        <!-- Bouton de retour -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="← Retour au Dashboard" onAction="#onBackToDashboard" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        </HBox>
        
        <Label text="Gestion des Providers" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        
        <GridPane hgap="10" vgap="10">
            <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            
            <Label text="Contact:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="contactNomField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            
            <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            
            <Label text="Téléphone:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="numeroTelField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            
            <Label text="Prix:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="prixAbonnementField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            
            <Label text="Logo URL:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="logoUrlField" GridPane.rowIndex="5" GridPane.columnIndex="1" promptText="https://example.com/logo.png"/>
            
            <Label text="Site URL:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextField fx:id="siteUrlField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            
            <Label text="Description:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
            <TextArea fx:id="descriptionArea" GridPane.rowIndex="7" GridPane.columnIndex="1" prefHeight="60"/>
        </GridPane>
        
        <HBox spacing="10">
            <Button text="Ajouter" onAction="#onAddProvider"/>
            <Button text="Modifier" onAction="#onUpdateProvider"/>
            <Button text="Supprimer" onAction="#onDeleteProvider"/>
            <Button text="Annuler" onAction="#onClearFields"/>
        </HBox>
        
        <Label fx:id="messageLabel"/>
        
        <TableView fx:id="providersTable" prefHeight="250" prefWidth="850">
            <columns>
                <TableColumn fx:id="logoColumn" text="Logo" prefWidth="80"/>
                <TableColumn fx:id="nomColumn" text="Nom" prefWidth="180"/>
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="200"/>
                <TableColumn fx:id="prixColumn" text="Prix" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>